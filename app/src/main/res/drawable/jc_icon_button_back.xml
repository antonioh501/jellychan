<?xml version="1.0" encoding="utf-8"?>
<!-- JellyChan: icon-only button, transparent until focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="120" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><corners android:radius="999dp" /><solid android:color="#FFE5E7EB" /></shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
