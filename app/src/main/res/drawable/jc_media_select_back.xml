<?xml version="1.0" encoding="utf-8"?>
<!-- JellyChan: audio and subtitle track selectors -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="120" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><corners android:radius="6dp" /><solid android:color="#FFE5E7EB" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#FF384252" />
            <stroke android:width="1dp" android:color="#FF47505C" />
        </shape>
    </item>
</selector>
