<?xml version="1.0" encoding="utf-8"?>
<!-- JellyChan: main action pill, same colors as the home carousel buttons: blue at rest, white when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="@integer/button_fade_duration" android:exitFadeDuration="@integer/button_fade_duration">
    <item android:state_focused="true">
        <inset android:inset="4dp">
            <shape android:shape="rectangle">
                <corners android:radius="999dp" />
                <solid android:color="?attr/buttonDefaultHighlightBackground" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:inset="4dp">
            <shape android:shape="rectangle">
                <corners android:radius="999dp" />
                <solid android:color="?attr/buttonDefaultNormalBackground" />
            </shape>
        </inset>
    </item>
</selector>
