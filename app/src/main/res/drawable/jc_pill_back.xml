<?xml version="1.0" encoding="utf-8"?>
<!-- JellyChan: main action pill. Light at rest, white with an outer ring when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="120" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <solid android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <inset android:inset="4dp">
            <shape android:shape="rectangle">
                <corners android:radius="999dp" />
                <solid android:color="#FFD1D5DB" />
            </shape>
        </inset>
    </item>
</selector>
