<?xml version="1.0" encoding="utf-8"?>
<!-- JellyChan OSD: dark gradient at top and bottom, clear in the middle -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="top" android:height="300dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#D9000000" android:centerColor="#66000000" android:centerY="0.5" android:endColor="#00000000" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="420dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#F2000000" android:centerColor="#B3000000" android:centerY="0.45" android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
