<?xml version="1.0" encoding="utf-8"?>
<!-- JellyChan: popup menu background, the padding keeps the focused row inside the rounded corners -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="?attr/popupMenuRounding" />
    <solid android:color="?attr/popupMenuBackground" />
    <padding
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp" />
</shape>
