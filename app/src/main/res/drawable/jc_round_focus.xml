<?xml version="1.0" encoding="utf-8"?>
<!-- JellyChan: light circle behind focused small icons / letters -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="100" android:exitFadeDuration="100">
    <item android:state_focused="true">
        <shape android:shape="oval"><solid android:color="#FFE5E7EB" /></shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
