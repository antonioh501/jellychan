<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="false"
        android:id="@+id/rowsFragment" />

    <!-- JellyChan: person photo stays fixed while the right column scrolls -->
    <org.jellyfin.androidtv.ui.AsyncImageView
        android:id="@+id/jcPersonFixedPhoto"
        android:layout_width="211dp"
        android:layout_height="317dp"
        android:layout_marginStart="53dp"
        android:layout_marginTop="112dp"
        android:background="@drawable/shape_card"
        android:outlineProvider="background"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <org.jellyfin.androidtv.ui.ClockUserView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/fdClock"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="false"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="40sp" />

    <org.jellyfin.androidtv.ui.NowPlayingView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/npBug"
        android:layout_alignBottom="@+id/fdClock"
        android:layout_marginEnd="25dp"
        android:layout_toStartOf="@+id/fdClock" />

</RelativeLayout>
