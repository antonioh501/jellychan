<?xml version="1.0" encoding="utf-8"?>
<!--
    JellyChan library page:
    "<- Library" header, centered tab pills, centered counter + tools, poster grid, A-Z index on the right.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header: back button + library name -->
    <ImageView
        android:id="@+id/jc_library_back"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/jc_round_focus"
        android:clickable="true"
        android:contentDescription="@string/jc_back"
        android:focusable="true"
        android:padding="6dp"
        android:src="@drawable/jc_ic_arrow_back"
        android:tint="@color/jc_tab_text" />

    <TextView
        android:id="@+id/jc_library_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/jc_library_back"
        android:layout_alignBottom="@+id/jc_library_back"
        android:layout_marginStart="16dp"
        android:layout_toEndOf="@+id/jc_library_back"
        android:fontFamily="@font/inter_medium"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        tools:text="Movies" />

    <org.jellyfin.androidtv.ui.ClockUserView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp" />

    <org.jellyfin.androidtv.ui.NowPlayingView
        android:id="@+id/npBug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/clock"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="15dp"
        android:layout_toStartOf="@+id/clock" />

    <!-- Tabs -->
    <LinearLayout
        android:id="@+id/jc_tabs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/jc_library_back"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="horizontal" />

    <!-- Counter + tools -->
    <LinearLayout
        android:id="@+id/jc_tools_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/jc_tabs"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/inter_medium"
            android:textColor="#FFD1D5DB"
            android:textSize="12sp"
            tools:text="1-178 di 178" />

        <LinearLayout
            android:id="@+id/toolBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- A-Z quick index -->
    <LinearLayout
        android:id="@+id/jc_alpha_index"
        android:layout_width="18dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="60dp"
        android:gravity="center_horizontal"
        android:orientation="vertical" />

    <FrameLayout
        android:id="@+id/rowsFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/jc_tools_row"
        android:layout_marginTop="6dp"
        android:layout_toStartOf="@+id/jc_alpha_index" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Kept for code compatibility, not shown in this layout -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/infoRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</RelativeLayout>
