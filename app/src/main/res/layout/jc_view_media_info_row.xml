<?xml version="1.0" encoding="utf-8"?>
<!-- JellyChan: external ids, credits and media streams shown below the item header -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingTop="4dp"
    android:paddingEnd="56dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/jcMediaCredits"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/jc_media_panel_back"
            android:divider="@drawable/jc_media_panel_divider"
            android:orientation="vertical"
            android:showDividers="middle" />

        <Space
            android:id="@+id/jcMediaPanelGap"
            android:layout_width="16dp"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/jcMediaStreams"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/jc_media_panel_back"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp" />
    </LinearLayout>
</LinearLayout>
