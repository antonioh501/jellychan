<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="1dp"
    android:paddingBottom="1dp">

    <ImageView
        android:id="@+id/jcStreamIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/jc_ic_media_video" />

    <LinearLayout
        android:id="@+id/jcStreamBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:minHeight="28dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/jcStreamText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:maxLines="1"
            android:textColor="@color/jc_media_select_text"
            android:textSize="12sp"
            tools:text="Japanese - Dolby Digital+ - Stereo - Default" />

        <ImageView
            android:id="@+id/jcStreamChevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:src="@drawable/jc_ic_chevron_down"
            android:tint="@color/jc_media_select_text" />
    </LinearLayout>
</LinearLayout>
