<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:duplicateParentState="true"
    android:layoutDirection="ltr">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageButton"
        style="@style/Button.Default"
        android:layout_width="70dp"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:clickable="false"
        android:duplicateParentState="true"
        app:tint="@drawable/button_icon_tint"
        tools:ignore="UnusedAttribute"
        tools:src="@drawable/ic_play"
        android:layoutDirection="locale" />

    <!-- JellyChan: main action, icon and text inside a pill (replaces imageButton and label) -->
    <LinearLayout
        android:id="@+id/jcPill"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/jc_pill_back"
        android:duplicateParentState="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="30dp"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/jcPillIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:duplicateParentState="true"
            app:tint="@drawable/button_default_text" />

        <TextView
            android:id="@+id/jcPillText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:fontFamily="@font/inter_medium"
            android:maxLines="1"
            android:textColor="@drawable/button_default_text"
            android:textSize="15sp"
            tools:text="Play" />
    </LinearLayout>

    <TextView
        android:id="@+id/label"
        android:layout_width="85dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/imageButton"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="2dp"
        android:textColor="@color/jc_text_dim"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:textSize="12sp"
        tools:text="TextView" />
</RelativeLayout>
