<?xml version="1.0" encoding="utf-8"?>
<!--
    JellyChan home spotlight (carousel). The backdrop / muted trailer is drawn full screen
    by AppBackground in spotlight mode; this view only holds the item info and actions.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/jc_home_spotlight_height"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/jcInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="38dp"
        android:layout_marginEnd="38dp"
        android:layout_marginBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <org.jellyfin.androidtv.ui.AsyncImageView
            android:id="@+id/jcLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:adjustViewBounds="true"
            android:maxWidth="400dp"
            android:maxHeight="110dp"
            android:scaleType="fitStart" />

        <TextView
            android:id="@+id/jcTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/inter_bold"
            android:maxLines="2"
            android:shadowColor="#99000000"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textColor="@color/white"
            android:textSize="40sp"
            tools:text="Title" />

        <LinearLayout
            android:id="@+id/jcMeta"
            android:layout_width="wrap_content"
            android:layout_height="22sp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/jcOverview"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="2"
            android:shadowColor="#CC000000"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="@color/jc_text"
            android:textSize="15sp"
            tools:text="Overview" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/jcPlay"
                style="@style/Button.Default"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:drawableStart="@drawable/jc_ic_play_outline"
                android:fontFamily="@font/inter_semibold"
                android:minWidth="0dp"
                android:drawablePadding="4dp"
                android:paddingStart="16dp"
                android:paddingEnd="20dp"
                android:text="@string/lbl_play"
                android:textAllCaps="false"
                android:textSize="14sp" />

            <Button
                android:id="@+id/jcDetails"
                style="@style/Button.Default"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/inter_semibold"
                android:minWidth="0dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/jc_details"
                android:textAllCaps="false"
                android:textSize="14sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/jcDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
