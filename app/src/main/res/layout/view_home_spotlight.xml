<?xml version="1.0" encoding="utf-8"?>
<!--
    JellyChan home spotlight (carousel). The backdrop / muted trailer is drawn full screen
    by AppBackground in spotlight mode; this view only holds the item info and actions,
    on the left, right of the home icon rail.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/jcInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/jc_home_content_start"
        android:layout_marginBottom="@dimen/jc_home_spotlight_info_margin_bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <org.jellyfin.androidtv.ui.AsyncImageView
            android:id="@+id/jcLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:adjustViewBounds="true"
            android:maxWidth="340dp"
            android:maxHeight="96dp"
            android:scaleType="fitStart" />

        <TextView
            android:id="@+id/jcTitle"
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/inter_bold"
            android:maxLines="2"
            android:shadowColor="#99000000"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textColor="@color/white"
            android:textSize="34sp"
            tools:text="Title" />

        <org.jellyfin.androidtv.ui.browsing.composable.inforow.JcDetailsInfoRowView
            android:id="@+id/jcMeta"
            android:layout_width="wrap_content"
            android:layout_height="22sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/jcOverview"
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="3"
            android:shadowColor="#CC000000"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="@color/jc_text"
            android:textSize="14sp"
            tools:text="Overview" />

        <Button
            android:id="@+id/jcDetails"
            style="@style/Button.Default"
            android:layout_width="@dimen/jc_home_spotlight_button_width"
            android:layout_height="30dp"
            android:fontFamily="@font/inter_semibold"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/jc_details"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <Button
            android:id="@+id/jcPlay"
            style="@style/Button.Default"
            android:layout_width="@dimen/jc_home_spotlight_button_width"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/jc_ic_play_outline"
            android:drawablePadding="4dp"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="@string/lbl_play"
            android:textAllCaps="false"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
